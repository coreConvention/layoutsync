<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>LayoutSync.Mcp</RootNamespace>
    <!-- The DLL name matches AssemblyName so .mcp.json can address `dotnet LayoutSync.Mcp.dll` -->
    <AssemblyName>LayoutSync.Mcp</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- MCP server SDK with stdio transport + DI hosting -->
    <PackageReference Include="ModelContextProtocol" Version="1.2.0" />

    <!-- Hosting and DI -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />

    <!-- Logging — Serilog routed to stderr so stdout stays clean for MCP framing -->
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="5.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- The mutation/validation/IO logic lives in LayoutSync.Core; this project only
         provides the MCP transport + tool surface. -->
    <ProjectReference Include="..\LayoutSync.Core\LayoutSync.Core.csproj" />
  </ItemGroup>
</Project>
